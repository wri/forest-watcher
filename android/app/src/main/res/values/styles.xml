<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:textColor">#000000</item>
        <!-- react-native-navigation topBar button text - removing forced uppercase -->
        <item name="textAllCaps">false</item>
        <!-- Extend app background behind the system navigation bar -->
        <item name="android:windowBackground">#f2f2f2</item>
        <item name="android:navigationBarColor">#f2f2f2</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
